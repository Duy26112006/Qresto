        <mxCell id="7tUdgp1Uc2SRcMkq9XLg-26" value="Áp dụng cho Chờ xác nhận và Chờ chế biến: Có yêu cầu hủy Chờ duyệt thì chặn xác nhận và bắt đầu chế biến dòng này." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=13;fontColor=#000000;size=22;" vertex="1" parent="1">
          <mxGeometry x="250" y="610" width="430" height="76" as="geometry" />
        </mxCell>
        <mxCell id="7tUdgp1Uc2SRcMkq9XLg-27" value="Áp dụng cho Đang chế biến và Sẵn sàng phục vụ: Sự cố là cờ trên dòng món, không phải trạng thái. Khi có sự cố chưa giải quyết thì không được sang Sẵn sàng phục vụ hoặc Đã phục vụ. Hủy dòng món thì sự cố tự kết thúc." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=13;fontColor=#000000;size=22;" vertex="1" parent="1">
