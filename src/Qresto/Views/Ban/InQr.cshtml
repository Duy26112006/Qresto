@model List<DiningTable>
@{
    ViewData["Title"] = "In mã QR";
    string baseUrl = ViewBag.BaseUrl;
}
<div class="khong-in mb-3">
    <a asp-action="Index" class="btn btn-sm btn-light">&larr; Quay lại</a>
    <button class="btn btn-sm btn-primary" onclick="window.print()">In</button>
    <span class="small text-muted ms-2">Địa chỉ trong QR: @baseUrl</span>
</div>
<div class="row g-3">
    @foreach (var t in Model)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="qr-o">
                <div class="fw-bold fs-5">@t.Name</div>
                <div class="qr" data-link="@(baseUrl + "/ban/" + t.QrToken)"></div>
                <div class="small">Quét mã để xem thực đơn và gọi món</div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/qrcode/qrcode.js"></script>
    <script>
        document.querySelectorAll('.qr').forEach(el => {
            const qr = qrcode(0, 'M');
            qr.addData(el.dataset.link);
            qr.make();
            el.innerHTML = qr.createImgTag(5, 8);
        });
    </script>
}
