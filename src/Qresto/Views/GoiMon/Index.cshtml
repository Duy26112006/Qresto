@model GuestMenuViewModel
@{
    ViewData["Title"] = Model.Table.Name;
    Layout = "_LayoutKhach";
    var token = Model.Table.QrToken;
}
<div id="app"
     data-token="@token"
     data-session="@(Model.SessionId?.ToString() ?? "")"
     data-turn="@Model.Turn"
     data-url-status="/ban/@token/trang-thai"
     data-url-send="/ban/@token/gui-don"
     data-url-cancel="/ban/@token/yeu-cau-huy"
     data-url-support="/ban/@token/ho-tro"
     data-url-pay="/ban/@token/yeu-cau-thanh-toan">

    <header class="kh-header">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <div class="kh-ten-ban">@Model.Table.Name</div>
                <div class="small" id="trangThaiBan">
                    @(Model.SessionStatus == SessionStatus.ChoThanhToan ? "Đang chờ thanh toán" : "Chào mừng bạn!")
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-light" id="btnMonDaGoi">
                Món đã gọi <span class="badge bg-qresto" id="soMonDaGoi">0</span>
            </button>
        </div>
        <input type="search" id="timMon" class="form-control form-control-sm mt-2" placeholder="Tìm món..." autocomplete="off" />
        <nav class="kh-danh-muc" id="danhMuc">
            <button type="button" class="chip active" data-cat="">Tất cả</button>
            @foreach (var c in Model.Categories)
            {
                <button type="button" class="chip" data-cat="@c.Id">@c.Name</button>
            }
        </nav>
    </header>


    <div id="thongBaoBan" class="alert alert-warning mx-2 mt-2 mb-0 small d-none"></div>

    <div class="kh-thuc-don" id="thucDon">
        @foreach (var c in Model.Categories)
        {
            <section class="nhom-mon" data-cat="@c.Id">
                <h6 class="ten-nhom">@c.Name</h6>
                @foreach (var m in c.MenuItems)
                {
                    <div class="mon @(m.Status == MenuItemStatus.TamHet ? "het" : "")"
                         data-id="@m.Id" data-name="@m.Name" data-price="@m.Price" data-status="@m.Status">
                        @if (!string.IsNullOrEmpty(m.ImageUrl))
                        {
                            <img src="@m.ImageUrl" class="mon-anh" alt="@m.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="mon-anh mon-anh-trong">@m.Name.Substring(0, 1)</div>
                        }
                        <div class="mon-thong-tin">
                            <div class="mon-ten">@m.Name</div>
                            @if (!string.IsNullOrEmpty(m.Description))
                            {
                                <div class="mon-mo-ta">@m.Description</div>
                            }
                            <div class="d-flex align-items-center justify-content-between mt-1">
                                <span class="mon-gia">@m.Price.Vnd()</span>
                                <div class="mon-nut"></div>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }
        <p class="text-center text-muted small py-3 d-none" id="khongThayMon">Không tìm thấy món phù hợp.</p>
    </div>

    <!-- thanh xem gio ghim duoi man hinh -->
    <div class="kh-thanh-gio d-none" id="thanhGio">
        <button type="button" class="btn btn-qresto w-100 py-2" id="btnXemGio">
            Xem giỏ (<span id="soPhan">0</span>) · <span id="tongGio">0 đ</span>
        </button>
    </div>
</div>

<!-- Gio hang mo tu duoi len -->
<div class="offcanvas offcanvas-bottom kh-sheet" tabindex="-1" id="gioHang">
    <div class="offcanvas-header pb-1">
        <h6 class="offcanvas-title">Giỏ của bạn</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body pt-1">
        <div id="dsGio"></div>
        <div class="text-danger small mt-2" id="loiGio"></div>
    </div>
    <div class="kh-sheet-footer">
        <div class="d-flex justify-content-between mb-2">
            <span>Tổng giỏ</span><strong id="tongGio2">0 đ</strong>
        </div>
        <button type="button" class="btn btn-qresto w-100" id="btnGuiDon">Gửi đơn</button>
        <div class="small text-muted mt-1">Món sẽ được nhân viên xác nhận trước khi chuyển xuống bếp.</div>
    </div>
</div>

<!-- Mon da goi cua ca ban -->
<div class="offcanvas offcanvas-bottom kh-sheet" tabindex="-1" id="monDaGoi">
    <div class="offcanvas-header pb-1">
        <h6 class="offcanvas-title">Món đã gọi của bàn</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body pt-1">
        <div id="dsDaGoi"><p class="text-muted small">Bàn chưa gọi món nào.</p></div>
    </div>
    <div class="kh-sheet-footer">
        <div class="d-flex justify-content-between">
            <span>Tạm tính</span><strong id="tamTinh">0 đ</strong>
        </div>
        <div class="small text-muted mb-2" id="choXacNhan"></div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" data-ho-tro="GoiNhanVien">Gọi nhân viên</button>
            <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" data-ho-tro="XinDungCu">Xin dụng cụ</button>
        </div>
        <button type="button" class="btn btn-outline-qresto w-100 mt-2" id="btnThanhToan">Yêu cầu thanh toán</button>
    </div>
</div>

<!-- Ly do huy -->
<div class="modal fade" id="huyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">Yêu cầu hủy <span id="huyTenMon"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <textarea class="form-control" id="huyLyDo" rows="2" maxlength="300" placeholder="Lý do (bắt buộc), vd: gọi nhầm"></textarea>
                <div class="small text-muted mt-1">Nhân viên sẽ xem và xác nhận yêu cầu hủy.</div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger" id="btnGuiHuy">Gửi yêu cầu</button>
            </div>
        </div>
    </div>
</div>

<div class="kh-toast" id="khToast"></div>

@section Scripts {
    <script src="~/js/goimon.js" asp-append-version="true"></script>
}
