@{
    ViewData["Title"] = "Trang chủ";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h4 class="mb-2">Qresto - gọi món tại bàn</h4>
                <p class="text-muted">
                    Khách quét mã QR dán trên bàn để xem thực đơn và gọi món trên điện thoại.
                    Trang này dành cho nhân viên nhà hàng.
                </p>
                <a class="btn btn-qresto" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập nhân viên</a>
            </div>
        </div>
        <p class="small text-muted mt-3 mb-0">
            Đồ án thực tế CNPM - Nhóm 8
        </p>
    </div>
</div>
