<mxfile host="Electron" type="device"><diagram name="Trang-1" id="d1"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="742" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Use case: bàn, mã QR, phiên phục vụ và đăng nhập (Nguyễn Khánh Duy)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="778" height="30" as="geometry"/></mxCell><mxCell id="sys" value="Website Qresto" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="170" y="60" width="900" height="592" as="geometry"/></mxCell><mxCell id="u1" value="Quét QR, vào thực đơn của bàn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#B7950B;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="330" height="38" as="geometry"/></mxCell><mxCell id="k" value="Khách hàng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="87" width="36" height="60" as="geometry"/></mxCell><mxCell id="u2" value="Đăng nhập / đăng xuất" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#B7950B;" vertex="1" parent="1"><mxGeometry x="220" y="188" width="330" height="38" as="geometry"/></mxCell><mxCell id="u3" value="Đổi mật khẩu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#B7950B;" vertex="1" parent="1"><mxGeometry x="220" y="246" width="330" height="38" as="geometry"/></mxCell><mxCell id="nv" value="Nhân viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="204" width="36" height="60" as="geometry"/></mxCell><mxCell id="u4" value="Xem sơ đồ bàn và chi tiết phiên" style="ellipse;whiteSpace