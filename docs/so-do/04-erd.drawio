<mxfile host="Electron" type="device"><diagram name="Trang-1" id="d1"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Qresto - ERD (SQLite, EF Core)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="349" height="30" as="geometry"/></mxCell><mxCell id="DiningTables" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;DiningTables&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;Code TEXT NN UNIQUE&lt;br&gt;Name TEXT NN&lt;br&gt;QrToken TEXT NN UNIQUE&lt;br&gt;IsActive INTEGER NN&lt;br&gt;TurnVersion INTEGER NN&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="270" height="138" as="geometry"/></mxCell><mxCell id="DiningSessions" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;DiningSessions&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;FK DiningTableId INTEGER NN&lt;br&gt;Status TEXT NN&lt;br&gt;StartedAt TEXT NN&lt;br&gt;EndedAt TEXT&lt;br&gt;PaymentVersion INTEGER NN&lt;br&gt;CancelReason TEXT&lt;br&gt;EndedById TEXT&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="270" height="172" as="geometry"/></mxCell><mxCell id="Orders" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Orders&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;FK DiningSessionId INTEGER NN&lt;br&gt;GuestKey TEXT NN&lt;br&gt;ClientRequestId TEXT NN UNIQUE&lt;br&gt;ContentHash TEXT NN&lt;br&gt;CreatedAt TEXT NN&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="70" width="270" height="138" as="geometry"/></mxCell><mxCell id="OrderItems" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;OrderItems&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;FK OrderId INTEGER NN&lt;br&gt;FK MenuItemId INTEGER NN&lt;br&gt;ItemName TEXT NN&lt;br&gt;UnitPrice INTEGER NN  (≥ 0)&lt;br&gt;Quantity INTEGER NN  (1..50)&lt;br&gt;Note TEXT  (≤ 300)&lt;br&gt;Status TEXT NN&lt;br&gt;ConfirmedAt / StartedAt TEXT&lt;br&gt;ReadyAt / ServedAt TEXT&lt;br&gt;RejectReason / CancelReason TEXT&lt;br&gt;HasIncident INTEGER NN&lt;br&gt;IncidentNote TEXT&lt;br&gt;IncidentReportedAt TEXT&lt;br&gt;Version INTEGER NN&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="70" width="270" height="291" as="geometry"/></mxCell><mxCell id="MenuItems" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;MenuItems&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;FK CategoryId INTEGER NN&lt;br&gt;Name TEXT NN&lt;br&gt;Description TEXT&lt;br&gt;Price INTEGER NN  (&amp;gt; 0)&lt;br&gt;ImageUrl TEXT&lt;br&gt;Status TEXT NN&lt;br&gt;PrepTimeMinutes INTEGER NN&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="70" width="270" height="172" as="geometry"/></mxCell><mxCell id="Categories" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Categories&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;Name TEXT NN UNIQUE&lt;br&gt;DisplayOrder INTEGER NN&lt;br&gt;IsActive INTEGER NN&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="360" width="270" height="104" as="geometry"/></mxCell><mxCell id="CancelRequests" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;CancelRequests&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;FK OrderItemId INTEGER NN&lt;br&gt;GuestKey TEXT NN&lt;br&gt;Reason TEXT NN&lt;br&gt;Status TEXT NN&lt;br&gt;CreatedAt TEXT NN&lt;br&gt;HandledAt TEXT&lt;br&gt;HandledById TEXT&lt;br&gt;HandleNote TEXT&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="520" width="270" height="189" as="geometry"/></mxCell><mxCell id="GuestSessionAccesses" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;GuestSessionAccesses&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;FK DiningSessionId INTEGER NN&lt;br&gt;GuestKey TEXT NN&lt;br&gt;IssuedAt TEXT NN&lt;br&gt;RevokedAt TEXT&lt;br&gt;UNIQUE (DiningSessionId, GuestKey)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="270" height="138" as="geometry"/></mxCell><mxCell id="SupportRequests" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;SupportRequests&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;FK DiningSessionId INTEGER NN&lt;br&gt;Type TEXT NN&lt;br&gt;Note TEXT&lt;br&gt;Status TEXT NN&lt;br&gt;CreatedAt TEXT NN&lt;br&gt;AcceptedAt / CompletedAt TEXT&lt;br&gt;HandledById TEXT&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="270" height="172" as="geometry"/></mxCell><mxCell id="Invoices" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Invoices&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;FK DiningSessionId INTEGER NN UNIQUE&lt;br&gt;TableName TEXT&lt;br&gt;Total INTEGER NN&lt;br&gt;PaymentMethod TEXT NN&lt;br&gt;PaidAt TEXT NN&lt;br&gt;CashierId TEXT NN&lt;br&gt;CashierName TEXT&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="420" width="270" height="172" as="geometry"/></mxCell><mxCell id="InvoiceItems" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;InvoiceItems&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;FK InvoiceId INTEGER NN&lt;br&gt;OrderItemId INTEGER  (truy vết)&lt;br&gt;MenuItemId INTEGER  (truy vết)&lt;br&gt;ItemName TEXT NN&lt;br&gt;Quantity INTEGER NN&lt;br&gt;UnitPrice INTEGER NN&lt;br&gt;LineTotal INTEGER NN&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="760" width="270" height="172" as="geometry"/></mxCell><mxCell id="AspNetUsers" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;AspNetUsers (Identity)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id TEXT&lt;br&gt;UserName TEXT&lt;br&gt;PasswordHash TEXT&lt;br&gt;FullName TEXT NN&lt;br&gt;IsActive INTEGER NN&lt;br&gt;… các cột khác của Identity&lt;br&gt;(vai trò: AspNetRoles, AspNetUserRoles)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="420" width="270" height="155" as="geometry"/></mxCell><mxCell id="ActivityLogs" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ActivityLogs&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;PK Id INTEGER&lt;br&gt;DiningSessionId INTEGER&lt;br&gt;OrderItemId INTEGER&lt;br&gt;Action TEXT NN&lt;br&gt;FromStatus / ToStatus TEXT&lt;br&gt;Reason TEXT&lt;br&gt;ActorType TEXT NN&lt;br&gt;ActorId / ActorName TEXT&lt;br&gt;At TEXT NN&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="650" width="270" height="189" as="geometry"/></mxCell><mxCell id="n1" value="Ràng buộc chính:&lt;br&gt;1. IX_DiningSessions_OnePerTable: UNIQUE(DiningTableId)&lt;br&gt;   WHERE Status IN (&#x27;DangPhucVu&#x27;,&#x27;ChoThanhToan&#x27;)&lt;br&gt;   -&gt; mỗi bàn tối đa một phiên đang hoạt động, hai điện thoại gửi cùng lúc không tạo 2 phiên.&lt;br&gt;2. Orders.ClientRequestId UNIQUE -&gt; gửi lại cùng mã không tạo đơn trùng.&lt;br&gt;3. Invoices.DiningSessionId UNIQUE -&gt; mỗi phiên tối đa một hóa đơn.&lt;br&gt;4. OrderItems.Version là concurrency token -&gt; phát hiện hai người cùng sửa một dòng món.&lt;br&gt;5. CHECK: Quantity 1..50, UnitPrice &gt;= 0, MenuItems.Price &gt; 0.&lt;br&gt;6. Khóa ngoại dùng ON DELETE RESTRICT (trừ InvoiceItems -&gt; Invoices là CASCADE).&lt;br&gt;7. Enum lưu TEXT, thời gian lưu TEXT (định dạng ISO của EF Core SQLite).&lt;br&gt;8. ActivityLogs chỉ lưu Id để tra cứu, không đặt khóa ngoại để log không chặn xóa/sửa." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#C9B458;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="800" width="590" height="190" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;entryX=0.000;entryY=0.465;exitX=1.000;exitY=0.580;" edge="1" parent="1" source="DiningTables" target="DiningSessions"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;entryX=0.000;entryY=0.580;exitX=1.000;exitY=0.465;" edge="1" parent="1" source="DiningSessions" target="Orders"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;entryX=0.000;entryY=0.275;exitX=1.000;exitY=0.580;" edge="1" parent="1" source="Orders" target="OrderItems"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;entryX=1.000;entryY=0.275;exitX=0.000;exitY=0.465;" edge="1" parent="1" source="MenuItems" target="OrderItems"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;entryX=0.5;entryY=1;exitX=0.5;exitY=0;" edge="1" parent="1" source="Categories" target="MenuItems"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" edge="1" parent="1" source="OrderItems" target="CancelRequests"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;entryX=1.000;entryY=0.507;exitX=0.000;exitY=0.843;" edge="1" parent="1" source="DiningSessions" target="GuestSessionAccesses"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="215"/><mxPoint x="330" y="400"/></Array></mxGeometry></mxCell><mxCell id="e7" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;entryX=1.000;entryY=0.465;exitX=0.000;exitY=1.017;" edge="1" parent="1" source="DiningSessions" target="SupportRequests"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="245"/><mxPoint x="345" y="660"/></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" edge="1" parent="1" source="DiningSessions" target="Invoices"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="html=1;rounded=0;endSize=10;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" edge="1" parent="1" source="Invoices" target="InvoiceItems"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>